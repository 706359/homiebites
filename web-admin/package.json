{
  "name": "homiebites-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 5050",
    "dev:watch": "next dev -p 5050",
    "dev:webpack": "next dev -p 5050 --webpack",
    "dev:clean": "rm -rf .next node_modules/.cache && next dev -p 5050",
    "build": "next build",
    "start": "next start -p 5050",
    "stop": "lsof -ti:5050 | xargs kill -9 2>/dev/null || echo 'No process found on port 5050'",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "push": "git add . && git commit -m \"$(./scripts/generate-commit-message.sh)\" && git push",
    "validate-css": "node scripts/validate-css.js",
    "validate-css:all": "node scripts/validate-css.js",
    "prebuild": "npm run validate-css:all",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.21.0",
    "next": "^16.1.1",
    "nodemailer": "^7.0.12",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.0",
    "vite": "^7.3.1"
  }
}
