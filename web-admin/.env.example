# API Configuration
# Set this to your production API URL
VITE_API_URL=http://localhost:3001

# Site Configuration (optional)
VITE_SITE_URL=https://homiebites.com

# Google Sheet sync (admin orders)
# Sheet ID from the URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
# GID = tab ID from URL (#gid=...) – e.g. 1604901714 for "All Data" tab
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_GID=1604901714
